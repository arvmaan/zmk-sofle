#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        td_caps: td_caps {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            label = "TD_CAPS";
            tapping-term-ms = <220>;
            bindings = <&caps_word>, <&kp CAPS>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // --- developer combos, layer 0 only ---
        // require-prior-idle-ms stops these firing mid-burst while typing fast.

        combo_shot_region {
            bindings = <&kp LG(LS(N4))>;
            key-positions = <34 35 36>;      // J K L
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        combo_shot_full {
            bindings = <&kp LG(LS(N3))>;
            key-positions = <47 48 49>;      // M , .
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        combo_shot_ui {
            bindings = <&kp LG(LS(N5))>;
            key-positions = <21 22 23>;      // U I O
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        combo_shot_clip {
            bindings = <&kp LG(LC(LS(N4)))>;
            key-positions = <33 34 35>;      // H J K  (region -> clipboard)
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        combo_cmd_palette {
            bindings = <&kp LG(LS(P))>;
            key-positions = <28 29 30>;      // S D F
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        combo_quick_open {
            bindings = <&kp LG(P)>;
            key-positions = <15 16 17>;      // W E R
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        combo_comment {
            bindings = <&kp LG(SLASH)>;
            key-positions = <41 42 43>;      // X C V
            timeout-ms = <50>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        // --- system layer: both top corners together, deliberately unreachable by accident ---

        combo_sys_mode {
            bindings = <&tog 4>;
            key-positions = <0 12>;          // ESC + BACKSPACE
            timeout-ms = <60>;
            layers = <0 4>;                  // usable to enter AND to leave
        };

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC     &kp N1  &kp N2            &kp N3        &kp N4    &kp N5       &none  &kp N6     &kp N7  &kp N8        &kp N9          &kp N0      &kp BACKSPACE
&kp TAB     &kp Q   &kp W             &kp E         &kp R     &kp T        &none  &kp Y      &kp U   &kp I         &kp O           &kp P       &kp BSLH
&td_caps    &kp A   &kp S             &kp D         &kp F     &kp G        &none  &kp H      &kp J   &kp K         &kp L           &kp SEMI    &kp APOS
&kp LSHFT   &kp Z   &kp X             &kp C         &kp V     &kp B        &none  &kp N      &kp M   &kp COMMA     &kp DOT         &kp FSLH    &kp RIGHT_SHIFT
&kp C_MUTE  &tog 2  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LGUI  &kp SPACE    &none  &kp ENTER  &mo 1   &msc SCRL_UP  &msc SCRL_DOWN  &kp DELETE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "REG";
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &none  &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &trans
&trans      &kp GRAVE        &mkp LCLK       &mkp MCLK        &mkp RCLK        &mkp MB4           &none  &kp PG_UP        &kp END          &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&trans      &kp TILDE        &trans          &trans           &trans           &mkp MB5           &none  &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &none  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &trans             &none  &trans           &trans           &trans      &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "CODE";
        };

        layer_2 {
            bindings = <
&kp TILDE  &trans  &trans  &trans  &trans  &trans    &none  &kp F6  &kp F7  &kp F8   &kp F9   &kp F10    &trans
&trans     &trans  &trans  &trans  &trans  &trans    &none  &trans  &trans  &kp F11  &kp F12  &kp UNDER  &kp PLUS
&trans     &trans  &trans  &trans  &trans  &trans    &none  &trans  &trans  &trans   &trans   &kp LBRC   &kp RBRC
&trans     &trans  &trans  &trans  &trans  &trans    &none  &trans  &trans  &trans   &trans   &trans     &trans
&trans     &trans  &trans  &trans  &trans  &trans    &none  &trans  &trans  &trans   &trans   &trans
            >;

            display-name = "LAYER2";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
&trans  &kp F1  &kp F2  &trans  &trans  &trans    &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &none  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &none  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "LAYER3";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &trans  &trans  &trans  &trans     &trans  &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &none  &trans  &trans  &trans  &trans     &trans  &trans
&trans  &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &none  &trans  &trans  &trans  &trans     &trans  &trans
&trans  &sys_reset    &trans          &bootloader   &trans        &trans          &none  &trans  &trans  &trans  &soft_off  &trans  &trans
&trans  &trans        &trans          &trans        &trans        &trans          &none  &trans  &trans  &trans  &trans     &trans
            >;

            display-name = "LAYER4";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "LAYER5";
        };
    };
};
